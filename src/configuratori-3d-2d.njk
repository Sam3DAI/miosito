{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import processSteps, faq, visualCardRail, finalCta %}

{% set scenarioItems = [
  { index: "01", label: "E-commerce", title: "Configuratore per e-commerce", text: "Varianti, materiali, accessori e scelta guidata prima del carrello.", href: "/configuratori-ecommerce" },
  { index: "02", label: "Rete vendita", title: "Portale commerciale", text: "Configurazioni salvabili e dati coerenti per agenti, dealer e clienti B2B.", href: "/software-cpq-portali-commerciali" },
  { index: "03", label: "Preventivazione", title: "Configuratore CPQ", text: "Regole prodotto, compatibilità, prezzi e documenti dentro un flusso controllato.", href: "/software-cpq-portali-commerciali" },
  { index: "04", label: "Composizione", title: "Planner e arredamento", text: "Moduli, misure, finiture e ambienti organizzati secondo il catalogo.", href: "/planner-configuratori-arredamento" }
] %}

{% set sectorItems = [
  { index: "01", label: "Moduli e ambienti", title: "Arredamento", text: "Composizioni, misure e finiture per produttori, showroom e rivenditori." },
  { index: "02", label: "Componenti", title: "Industria", text: "Regole tecniche, varianti e dati utili alla rete vendita e alla preventivazione." },
  { index: "03", label: "Allestimenti", title: "Automotive", text: "Optional, colori e combinazioni presentati in un percorso leggibile." },
  { index: "04", label: "Misure", title: "Serramenti", text: "Dimensioni, finiture, compatibilità e supporto alla preparazione dell’offerta." },
  { index: "05", label: "Esempio secondario", title: "Moda e accessori", text: "Colori, materiali e dettagli quando la personalizzazione incide sulla scelta." }
] %}

{% set processItems = [
  { title: "Catalogo", text: "Prodotti, varianti, dati e obiettivi." },
  { title: "Regole", text: "Compatibilità, dipendenze e vincoli." },
  { title: "Prototipo", text: "Flusso di scelta e rappresentazione." },
  { title: "Sviluppo", text: "Interfaccia, logiche e demo sul perimetro." },
  { title: "Integrazione", text: "Sistemi e passaggi realmente disponibili." },
  { title: "Test", text: "Prodotti, dispositivi e casi critici." }
] %}

{% set faqItems = [
  { question: "Qual è la differenza tra configuratore e-commerce, portale commerciale, CPQ e planner?", answer: "Il configuratore e-commerce guida la scelta prima dell’acquisto; il portale commerciale supporta agenti, dealer o clienti B2B; il CPQ applica regole, prezzi e preventivi; il planner organizza moduli, misure, finiture e ambienti." },
  { question: "È meglio un configuratore 2D o 3D?", answer: "Dipende da ciò che deve capire l’utente. Il 2D può essere più rapido e chiaro per opzioni e composizioni; il 3D e l’AR sono utili quando forma, materiali o percezione spaziale incidono davvero sulla scelta." },
  { question: "Il configuratore può integrarsi nel sito o nell’e-commerce esistente?", answer: "Spesso è possibile, ma la fattibilità va verificata su piattaforma, catalogo, API, checkout, autenticazione e sistemi che devono ricevere i dati." },
  { question: "Può gestire regole prodotto, prezzi e preventivi?", answer: "Sì, quando vincoli, listini e responsabilità sono formalizzabili. Il sistema può guidare le combinazioni e preparare riepiloghi o documenti per il flusso previsto." },
  { question: "Si può partire da cataloghi e processi già esistenti?", answer: "Sì. Cataloghi, listini, schede prodotto e passaggi commerciali esistenti sono il punto di partenza per definire dati, regole e priorità." }
] %}

{% block jsonLd %}
  <script type="application/ld+json">
