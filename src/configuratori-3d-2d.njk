{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import faq, visualCardRail, finalCta %}

{% set scenarioItems = [
  { label: "E-commerce", title: "Configuratore per e-commerce", text: "Personalizzazione del prodotto con varianti, materiali e accessori prima del carrello.", href: "/configuratori-ecommerce", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/Configuratore_e-commerce_x0cfvo.jpg", alt: "Configuratore e-commerce con anteprima prodotto e opzioni di personalizzazione" },
  { label: "Rete vendita", title: "Portale per rete commerciale", text: "Area riservata per agenti e B2B con configurazioni salvabili e supporto al processo di vendita.", href: "/software-cpq-portali-commerciali", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/Portale_commerciali_gu6ta3.jpg", alt: "Portale commerciale riservato con attività e configurazioni" },
  { label: "Preventivazione", title: "Configuratore CPQ", text: "Regole prodotto, compatibilità, prezzi e preventivi nello stesso percorso.", href: "/software-cpq-portali-commerciali", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/CPQ_lv1miq.jpg", alt: "Configuratore CPQ con opzioni e riepilogo economico" },
  { label: "Composizione", title: "Planner per arredamento", text: "Configurazione di moduli e finiture con una resa visiva chiara per facilitare la scelta.", href: "/planner-configuratori-arredamento", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/Planner_arredamento_eg9vpf.jpg", alt: "Planner per arredamento con composizione dell'ambiente" }
] %}

{% set sectorItems = [
  { label: "Moduli e ambienti", title: "Arredamento", text: "Configurazione di ambienti, moduli e finiture per produttori, showroom e rivenditori.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/arredamento_pdjefm.jpg", alt: "Configuratore per arredamento con ambiente e finiture" },
  { label: "Componenti", title: "Industria", text: "Regole tecniche, componenti e varianti per supportare rete vendita e preventivi.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/macchinari_e_attrezzature_ujxyrm.jpg", alt: "Configuratore industriale per macchinari e attrezzature" },
  { label: "Materiali e dettagli", title: "Moda e accessori", text: "Personalizzazione di colori, materiali e dettagli quando incidono sulla scelta.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/moda_e_acessori_cbiexl.jpg", alt: "Configuratore per moda e accessori con materiali personalizzabili" },
  { label: "Allestimenti", title: "Automotive", text: "Optional, colori e combinazioni presentati in un percorso leggibile.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/automotive_i0mcou.jpg", alt: "Configuratore automotive con scelta di colori e optional" },
  { label: "Misure", title: "Serramenti", text: "Dimensioni, finiture, compatibilità e supporto alla preparazione dell'offerta.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/serramenti_f2nxbu.jpg", alt: "Configuratore per serramenti con misure e finiture" }
] %}

{% set faqItems = [
  { question: "Quali sono le differenze tra configuratore e-commerce, portale commerciale, configuratore CPQ e planner per arredamento?", answer: "Il configuratore e-commerce guida il cliente finale nella personalizzazione; il portale commerciale supporta agenti, dealer o clienti B2B; il CPQ aggiunge regole, prezzi e preventivi; il planner organizza moduli, misure, finiture e ambienti." },
  { highlight: "2D o un configuratore 3D?", question: "Meglio un configuratore 2D o un configuratore 3D?", answer: "Dipende dal prodotto e dall'obiettivo. Il 2D può essere più rapido e chiaro per opzioni e composizioni; il 3D e l'AR sono utili quando forma, materiali o percezione spaziale incidono davvero sulla scelta." },
  { question: "Un configuratore si integra nel sito o e-commerce che uso già oggi?", answer: "Spesso è possibile, ma la fattibilità va verificata su piattaforma, catalogo, API, checkout, autenticazione e sistemi che devono ricevere i dati." },
  { question: "Un configuratore può gestire anche regole prodotto, prezzi e preventivi?", answer: "Sì, quando vincoli, listini e responsabilità sono formalizzabili. Il sistema può guidare le combinazioni e preparare riepiloghi o documenti per il flusso previsto." },
  { question: "Si può partire da un catalogo, listino o processo già esistente?", answer: "Sì. Cataloghi, listini, schede prodotto e passaggi commerciali esistenti sono il punto di partenza per definire dati, regole e priorità." },
  { question: "Per quali aziende ha davvero senso realizzare un configuratore su misura?", answer: "Soprattutto per aziende che vendono prodotti personalizzabili, gestiscono molte varianti o preventivi complessi e devono aiutare clienti o rete vendita a capire meglio cosa stanno scegliendo." }
] %}

