    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://solvex-ai3d.com/configuratori-3d-2d/#service",
        "name": "Configuratori web 2D/3D su misura",
        "serviceType": "Configuratori web di prodotto 2D, 3D e AR",
        "url": "https://solvex-ai3d.com/configuratori-3d-2d",
        "description": "Configuratori web su misura per guidare configurazioni, applicare regole e supportare preventivi.",
        "provider": { "@id": "https://solvex-ai3d.com/#organization" },
        "areaServed": "IT"
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://solvex-ai3d.com/configuratori-3d-2d/#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://solvex-ai3d.com" },
          { "@type": "ListItem", "position": 2, "name": "Configuratori 2D/3D", "item": "https://solvex-ai3d.com/configuratori-3d-2d" }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://solvex-ai3d.com/configuratori-3d-2d/#faq",
