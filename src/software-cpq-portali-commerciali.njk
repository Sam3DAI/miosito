{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import processSteps, faq, visualCardRail, finalCta %}

{% set processItems = [
  { title: "Mappa", text: "Utenti, regole, dati e documenti." },
  { title: "Priorità", text: "Flusso iniziale e confini operativi." },
  { title: "Prototipo", text: "Schermate e decisioni da verificare." },
  { title: "Sviluppo", text: "Moduli e autorizzazioni concordate." },
  { title: "Integrazione", text: "Importazioni e sistemi analizzati." },
  { title: "Rilascio", text: "Test, passaggio operativo e supporto." }
] %}

{% set moduleItems = [
  { label: "Offerta", title: "Preventivi e PDF", text: "Riepiloghi e documenti coerenti con configurazione e regole commerciali.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/CPQ_lv1miq.jpg", alt: "Configuratore CPQ con dati di configurazione e prezzo" },
  { label: "Accessi", title: "Account, ruoli e autorizzazioni", text: "Visibilità e azioni definite per responsabili, agenti, dealer e clienti.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/Portale_commerciali_gu6ta3.jpg", alt: "Portale commerciale con area riservata" },
  { label: "Continuità", title: "Salvataggi e duplicazioni", text: "Configurazioni riprese, duplicate o usate come base per nuove proposte." },
  { label: "Controllo", title: "Revisioni", text: "Versioni e passaggi di verifica mantengono leggibile l’evoluzione dell’offerta." },
  { label: "Rete", title: "Agenti, dealer e clienti B2B", text: "Spazi e percorsi calibrati sul ruolo e sul livello di autonomia previsto." },
  { label: "Dati", title: "Importazioni", text: "Cataloghi e dati possono essere acquisiti da formati concordati e controllabili." },
  { label: "Operatività", title: "Dashboard", text: "Viste operative focalizzate sulle informazioni necessarie alle decisioni." },
  { label: "Materiali", title: "Documenti", text: "Materiali commerciali raccolti o preparati nel punto utile del flusso." },
  { label: "Sistemi", title: "Integrazioni da analizzare", text: "ERP, CRM e altri sistemi vengono valutati sulle interfacce realmente disponibili." }
] %}

{% set faqItems = [
  { highlight: "CPQ", question: "Che differenza c'è tra un CPQ e un semplice configuratore?", answer: "Un CPQ collega configurazione, regole e logiche commerciali alla preparazione dell'offerta. Può includere listini, sconti, ruoli, revisioni e documenti, mentre un configuratore può fermarsi alla scelta del prodotto." },
  { question: "Può gestire listini e sconti diversi per agente o cliente?", answer: "Può farlo quando criteri, validità e fonti dei dati sono definiti. Ruoli e autorizzazioni stabiliscono chi vede o applica le informazioni commerciali." },
  { highlight: "preventivi e PDF", question: "Il portale può generare preventivi e PDF?", answer: "Sì. Il documento può raccogliere configurazione, dati commerciali e contenuti previsti, con regole di revisione o approvazione coerenti con il processo." },
  { highlight: "ERP, CRM", question: "Si collega a ERP, CRM o altri sistemi?", answer: "Le integrazioni si valutano sulle API, sui formati, sulla qualità dei dati e sulle responsabilità di ciascun sistema. Non vengono promesse compatibilità senza una verifica tecnica." },
  { question: "Si può partire da un solo flusso commerciale?", answer: "Sì. Un primo perimetro circoscritto permette di verificare il modello operativo e aggiungere moduli solo quando portano valore concreto." }
] %}

