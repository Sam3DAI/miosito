{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import processSteps, faq, finalCta %}

{% set processItems = [
  { title: "Mappa", text: "Utenti, regole, dati e documenti." },
  { title: "Priorità", text: "Flusso iniziale e confini operativi." },
  { title: "Prototipo", text: "Schermate e decisioni da verificare." },
  { title: "Sviluppo", text: "Moduli e autorizzazioni concordate." },
  { title: "Integrazione", text: "Importazioni e sistemi analizzati." },
  { title: "Rilascio", text: "Test, passaggio operativo e supporto." }
] %}

{% set faqItems = [
  { question: "Che differenza c'è tra un CPQ e un semplice configuratore?", answer: "Un CPQ collega configurazione, regole e logiche commerciali alla preparazione dell'offerta. Può includere listini, sconti, ruoli, revisioni e documenti, mentre un configuratore può fermarsi alla scelta del prodotto." },
  { question: "Può gestire listini e sconti diversi per agente o cliente?", answer: "Può farlo quando criteri, validità e fonti dei dati sono definiti. Ruoli e autorizzazioni stabiliscono chi vede o applica le informazioni commerciali." },
  { question: "Il portale può generare preventivi e PDF?", answer: "Sì. Il documento può raccogliere configurazione, dati commerciali e contenuti previsti, con regole di revisione o approvazione coerenti con il processo." },
  { question: "Si collega a ERP, CRM o altri sistemi?", answer: "Le integrazioni si valutano sulle API, sui formati, sulla qualità dei dati e sulle responsabilità di ciascun sistema. Non vengono promesse compatibilità senza una verifica tecnica." },
  { question: "Si può partire da un solo flusso commerciale?", answer: "Sì. Un primo perimetro circoscritto permette di verificare il modello operativo e aggiungere moduli solo quando portano valore concreto." }
] %}

