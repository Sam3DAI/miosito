{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import processSteps, faq, visualCardRail, finalCta %}

{% set processItems = [
  { title: "Catalogo", text: "Moduli, misure, finiture e codici." },
  { title: "Vincoli", text: "Regole tecniche e commerciali." },
  { title: "Prototipo", text: "Composizione e percorso da verificare." },
  { title: "Visuale", text: "2D o 3D secondo il valore utile." },
  { title: "Commerciale", text: "Prezzi, documenti e utenti B2B." },
  { title: "Integrazione", text: "Collegamenti e rilascio controllato." }
] %}

{% set compositionItems = [
  { label: "Prodotto", title: "Composizioni modulari", text: "Elementi e accessori vengono organizzati secondo sequenze e dipendenze reali.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/Planner_arredamento_eg9vpf.jpg", alt: "Planner per composizioni di arredamento" },
  { label: "Tecnica", title: "Misure e vincoli", text: "Dimensioni e incompatibilità possono essere controllate durante la composizione.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/serramenti_f2nxbu.jpg", alt: "Configuratore con misure e vincoli dimensionali" },
  { label: "Catalogo", title: "Cataloghi estesi", text: "Famiglie, codici e varianti richiedono una navigazione progettata sul prodotto.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/arredamento_pdjefm.jpg", alt: "Configuratore per cataloghi di arredamento" },
  { label: "Commerciale", title: "Rete commerciale", text: "Dealer e agenti hanno bisogno di dati coerenti per presentare e quotare la soluzione.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/Portale_commerciali_gu6ta3.jpg", alt: "Portale commerciale per dealer e agenti" }
] %}

{% set faqItems = [
  { question: "Il planner è pensato per produttori o rivenditori?", answer: "Può servire entrambi, oltre a showroom e reti vendita. Ruoli, cataloghi, listini e flussi vengono definiti sul modo in cui ogni soggetto compone e presenta il prodotto." },
  { highlight: "misure e incompatibilità", question: "Può controllare misure e incompatibilità?", answer: "Sì, quando vincoli e dipendenze sono formalizzabili. Il sistema può impedire combinazioni non valide o chiedere le informazioni necessarie prima di proseguire." },
  { highlight: "3D", question: "La visualizzazione deve essere in 3D?", answer: "Non necessariamente. Il 2D può essere più efficace per alcune composizioni; il 3D è utile quando volume, materiali o ambiente aiutano davvero la valutazione." },
  { highlight: "prezzi e preventivi", question: "Può preparare prezzi e preventivi?", answer: "Può collegare la composizione a listini, regole commerciali e documenti, se fonti dei dati e responsabilità del processo sono definite." },
  { question: "È pensato anche per clienti privati?", answer: "No. È una soluzione B2B progettata sui cataloghi e sui processi commerciali di produttori, rivenditori, showroom e reti vendita." }
] %}

