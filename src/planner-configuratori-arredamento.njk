{% block content %}
<main id="main-content">
  <section class="page-hero page-hero--compact page-hero--text">
    <div class="page-hero__layout container">
      <div class="page-hero__copy">
        <h1><span class="gradient-text">Planner e configuratori</span> per arredamento pensati per produttori e rivenditori.</h1>
        <div class="hero-introduction">
        <p class="hero-lead">Composizioni, misure e finiture in uno strumento B2B che aiuta showroom e reti vendita a preparare offerte coerenti con il catalogo.</p>
        <div class="cta-group">
          <a class="button button--page" href="#demo-form">Richiedi una Demo gratuita <span aria-hidden="true">↗</span></a>
          <a class="button button--page button--secondary" href="#funzioni">Esplora le funzioni <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      </div>
    </div>
  </section>

  <section class="section section--rail" aria-labelledby="composition-title">
    <div class="section-heading rail-heading">
      <span class="section-kicker">Composizione</span>
      <h2 id="composition-title">Comporre senza perdere il controllo del catalogo.</h2>
      <p>Il planner traduce moduli, misure e relazioni tecniche in un’esperienza utilizzabile da chi presenta, configura o vende il prodotto.</p>
    </div>
    {{ visualCardRail("planner-scenarios", "Scenari di composizione per arredamento", compositionItems) }}
  </section>

  <section class="section section--tinted" aria-labelledby="planner-functions-title">
    <div class="container">
      <div class="section-heading" id="funzioni">
        <span class="section-kicker">Funzioni</span>
        <h2 id="planner-functions-title">Dalla composizione alla proposta commerciale.</h2>
        <p>Ogni funzione viene dimensionata su catalogo, utenti e risultato che il processo deve produrre.</p>
      </div>
      <div class="feature-grid">
        <article class="card"><span class="card__label">Catalogo</span><h3>Moduli e collezioni</h3><p>Prodotti, componenti e famiglie organizzati per costruire composizioni coerenti.</p></article>
        <article class="card"><span class="card__label">Tecnica</span><h3>Misure e vincoli</h3><p>Controlli su dimensioni, adiacenze e incompatibilità quando le regole sono definibili.</p></article>
        <article class="card"><span class="card__label">Materiali</span><h3>Finiture e varianti</h3><p>Colori e materiali associati ai prodotti secondo disponibilità e combinazioni ammesse.</p></article>
        <article class="card"><span class="card__label">Visuale</span><h3>Vista 2D o 3D</h3><p>La rappresentazione viene scelta in base a ciò che utente e cliente devono comprendere.</p></article>
        <article class="card"><span class="card__label">Spazio</span><h3>Ambienti</h3><p>Dimensioni e contesto possono guidare il posizionamento quando fanno parte del caso d’uso.</p></article>
        <article class="card"><span class="card__label">Commerciale</span><h3>Prezzi e preventivi</h3><p>Composizione, listini e regole possono alimentare riepiloghi e documenti di offerta.</p></article>
        <article class="card"><span class="card__label">Utenti</span><h3>Dealer e agenti</h3><p>Ruoli e visibilità supportano i diversi attori della rete commerciale.</p></article>
        <article class="card"><span class="card__label">Continuità</span><h3>Salvataggio e condivisione</h3><p>Le composizioni possono essere riprese, condivise o trasformate in una richiesta.</p></article>
        <article class="card"><span class="card__label">Sistemi</span><h3>Integrazioni</h3><p>Cataloghi, listini, CRM o altri strumenti vengono collegati solo dopo analisi delle interfacce.</p></article>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="planner-proof-title">
    <div class="split-panel">
      <div class="split-panel__lead">
        <span class="section-kicker">Esperienza pertinente</span>
        <h2 id="planner-proof-title">Configuratore tecnico con listini e PDF.</h2>
      </div>
      <div class="split-panel__body">
        <p>Una tipologia di progetto già realizzata che unisce regole, opzioni e prezzi in un percorso guidato con generazione del preventivo.</p>
        <p>Queste competenze sono applicabili ai cataloghi di arredamento. L’esempio riguarda la configurazione tecnica, non un room planner già pubblicato.</p>
      </div>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="planner-process-title">
    <div class="container">
      <div class="section-heading"><span class="section-kicker">Processo</span><h2 id="planner-process-title">Catalogo e vincoli vengono prima della tecnologia visuale.</h2><p>Il livello di rappresentazione viene scelto dopo aver chiarito composizione, regole, utenti e risultato commerciale.</p></div>
      {{ processSteps(processItems) }}
    </div>
  </section>

  <section class="section container" aria-labelledby="faq-title">
    <div class="section-heading section-heading--center"><h2 id="faq-title"><span class="gradient-text">Domande</span> su planner e configuratori per arredamento.</h2></div>
    {{ faq(faqItems) }}
  </section>

  {% include "partials/service-demo-form.njk" %}

  <section class="section section--compact container">
    {{ finalCta("Il tuo catalogo richiede composizioni, vincoli e offerte?", "Descrivi prodotti, utenti e passaggi commerciali: valutiamo moduli, misure e documenti necessari alla tua rete vendita.", "Richiedi una Demo gratuita", false, "#demo-form") }}
  </section>
</main>
{% endblock %}
