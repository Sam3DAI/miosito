{% block content %}
<main id="main-content">
  <section class="page-hero page-hero--text">
    <div class="page-hero__layout container">
      <div class="page-hero__copy">
        <h1><span class="gradient-text">Configuratori</span> e software commerciali. Su misura.</h1>
        <div class="hero-introduction">
        <p class="hero-lead">Trasformiamo prodotti, listini e regole di vendita in strumenti web per configurare, preventivare e vendere con meno errori.</p>
        <div class="cta-group">
          <a class="button button--page button--project" href="/contattaci">Parliamo del tuo progetto <span aria-hidden="true">↗</span></a>
          <a class="button button--page button--secondary" href="#soluzioni">Esplora le soluzioni <span aria-hidden="true">↓</span></a>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--rail" aria-labelledby="complexity-title">
    <div class="section-heading rail-heading">
      <span class="section-kicker">Il problema</span>
      <h2 id="complexity-title">Quando il prodotto è complesso, la vendita non deve esserlo.</h2>
      <p>Un’interfaccia ben progettata rende esplicite le scelte, applica le regole e accompagna ogni utente verso un risultato verificabile.</p>
    </div>
    {{ visualCardRail("home-problems", "Problemi commerciali frequenti", problemItems) }}
  </section>

  <section class="section section--tinted" aria-labelledby="solutions-title">
    <div class="container">
      <div class="section-heading section-heading--statement" id="soluzioni">
        <span class="section-kicker">Soluzioni</span>
        <h2 id="solutions-title"><span class="statement-line">Una <span class="gradient-text">soluzione</span>.</span> <span class="statement-line">Per ogni processo <span class="gradient-text">di vendita</span>.</span></h2>
        <p>La tecnologia cambia, ma il criterio resta lo stesso: rendere più chiaro il percorso tra catalogo, scelta e proposta commerciale.</p>
      </div>
      <div class="solution-grid">
        <a class="card card--link" href="/configuratori-ecommerce">{{ functionIcon("configuration") }}<span class="card__label">E-commerce</span><h3>Guidare la <span class="gradient-text">personalizzazione</span> prima dell’acquisto.</h3><p>Varianti, compatibilità, prezzo e passaggio al carrello dentro un’esperienza coerente.</p><span class="card__arrow">Scopri i configuratori e-commerce <span aria-hidden="true">→</span></span></a>
        <a class="card card--link" href="/software-cpq-portali-commerciali">{{ functionIcon("pricing") }}<span class="card__label">B2B</span><h3>Governare regole, listini e <span class="gradient-text">preventivi</span>.</h3><p>Strumenti per agenti, dealer e clienti con ruoli, revisioni e documenti.</p><span class="card__arrow">Scopri CPQ e portali <span aria-hidden="true">→</span></span></a>
        <a class="card card--link" href="/planner-configuratori-arredamento">{{ functionIcon("rules") }}<span class="card__label">Arredamento</span><h3>Comporre <span class="gradient-text">spazi</span> e prodotti modulari.</h3><p>Misure, finiture, vincoli e offerte per produttori, showroom e rivenditori.</p><span class="card__arrow">Scopri planner e configuratori <span aria-hidden="true">→</span></span></a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="capabilities-title">
    <div class="section-heading section-heading--statement">
      <h2 id="capabilities-title"><span class="statement-line"><span class="gradient-text">Visualizzare</span> quando serve.</span> <span class="statement-line"><span class="gradient-text">Automatizzare</span> dove crea valore.</span></h2>
    </div>
    <div class="capability-strip">
      <a class="card card--link capability-card" href="/configuratori-3d-2d">
        <div class="capability-card__copy"><span class="card__label">2D / 3D</span><h3>Configuratori di prodotto interattivi.</h3><p>La componente visiva aiuta a comprendere varianti, materiali e risultato della configurazione.</p><span class="card__arrow">Esplora i configuratori 2D/3D <span aria-hidden="true">→</span></span></div>
        <figure class="capability-card__media"><img src="https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_1200,c_limit/v1777911837/Configuratore_e-commerce_x0cfvo.jpg" width="1200" height="900" alt="Illustrazione SolveX della configurazione di prodotto" loading="lazy" decoding="async"><figcaption>Visualizzazione illustrativa SolveX.</figcaption></figure>
      </a>
      <a class="card card--link capability-card" href="/automazioni-ai-business">
        <div class="capability-card__copy"><span class="card__label">AI integrata</span><h3>Automazioni dentro il processo commerciale.</h3><p>L’AI supporta documenti, richieste e workflow definiti, mantenendo controllo e supervisione.</p><span class="card__arrow">Esplora le automazioni AI <span aria-hidden="true">→</span></span></div>
        <figure class="capability-card__media"><img src="https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_1200,c_limit/v1752249260/Autodocs_AI_adhyrh.webp" width="1200" height="900" alt="Illustrazione SolveX dell’elaborazione di documenti con AI" loading="lazy" decoding="async"><figcaption>Visualizzazione illustrativa SolveX.</figcaption></figure>
      </a>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-heading section-heading--center section-heading--statement">
        <h2 id="flow-title"><span class="statement-line">Dal catalogo al <span class="gradient-text">preventivo</span>.</span> <span class="statement-line">In un <span class="gradient-text">unico flusso</span>.</span></h2>
        <p>Ogni modulo risponde a un passaggio concreto e può essere dimensionato sulle priorità del progetto.</p>
      </div>
      <ul class="function-grid" aria-label="Funzioni del flusso commerciale">
        <li class="editorial-card">{{ functionIcon("configuration") }}<strong>Configurazione</strong><p>Guida la scelta di varianti e opzioni del prodotto.</p></li>
        <li class="editorial-card">{{ functionIcon("rules") }}<strong>Regole</strong><p>Verifica compatibilità e dipendenze tra le scelte.</p></li>
        <li class="editorial-card">{{ functionIcon("pricing") }}<strong>Prezzi e listini</strong><p>Applica i dati commerciali previsti per la configurazione.</p></li>
        <li class="editorial-card">{{ functionIcon("users") }}<strong>Utenti e ruoli</strong><p>Definisce visibilità e azioni per ogni profilo.</p></li>
        <li class="editorial-card">{{ functionIcon("documents") }}<strong>PDF e documenti</strong><p>Raccoglie configurazione e dati nel riepilogo di offerta.</p></li>
        <li class="editorial-card">{{ functionIcon("saves") }}<strong>Salvataggi</strong><p>Permette di riprendere e condividere le configurazioni.</p></li>
        <li class="editorial-card">{{ functionIcon("revisions") }}<strong>Revisioni</strong><p>Mantiene leggibili versioni e passaggi di verifica.</p></li>
        <li class="editorial-card">{{ functionIcon("integrations") }}<strong>Integrazioni</strong><p>Collega cataloghi e sistemi dopo l’analisi delle interfacce.</p></li>
      </ul>
    </div>
  </section>

  <section class="section section--rail" aria-labelledby="projects-title">
    <div class="section-heading rail-heading" id="progetti">
      <span class="section-kicker">Esperienza applicata</span>
      <h2 id="projects-title">Tipologie di progetto già realizzate.</h2>
      <p>Esempi anonimi descritti per funzione, senza esporre nomi, dati o risultati dei clienti.</p>
    </div>
    {% set projectItems = [
      { title: "Configurazione 3D di prodotto.", text: "Un’esperienza web per selezionare varianti e leggere visivamente la configurazione.", icon: "configuration", image: "", alt: "" },
      { title: "Portale preventivi B2B.", text: "Un flusso riservato per organizzare configurazioni, dati commerciali e documenti.", icon: "users", image: "", alt: "" },
      { title: "Configuratore tecnico con listini e PDF.", text: "Regole, opzioni e prezzi raccolti in un percorso guidato con generazione del preventivo.", icon: "documents", image: "", alt: "" }
    ] %}
    {{ visualCardRail("home-projects", "Progetti anonimi per funzione", projectItems, "landscape") }}
  </section>

  <section class="section section--tinted" aria-labelledby="method-title">
    <div class="container">
      <div class="section-heading">
        <span class="section-kicker">Metodo</span>
        <h2 id="method-title">Dall’analisi al rilascio.</h2>
        <p>Decisioni visibili, verifiche progressive e una consegna costruita per chi dovrà usare la soluzione.</p>
      </div>
      {{ processSteps(methodSteps) }}
    </div>
  </section>

  <section class="section container" aria-labelledby="direct-title">
    <div class="split-panel">
      <div class="split-panel__lead">
        <span class="section-kicker">Collaborazione</span>
        <h2 id="direct-title">Un interlocutore diretto, competenze specialistiche quando servono.</h2>
        <p>SolveX mantiene un referente chiaro e la responsabilità diretta delle decisioni dall’analisi al rilascio.</p>
      </div>
      <div class="split-panel__body">
        <ul class="check-list">
          <li>Responsabilità chiara e confronto senza passaggi inutili.</li>
          <li>Specialisti coinvolti solo quando il perimetro lo richiede.</li>
          <li>Priorità, vincoli e verifiche condivisi durante il progetto.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="custom-process-title">
    <div class="container split-panel">
      <div class="split-panel__lead">
        <h2 id="custom-process-title">Hai un processo fuori standard?</h2>
      </div>
      <div class="split-panel__body">
        <p>SolveX realizza anche portali e software web su misura quando il progetto riguarda cataloghi, preventivi, documenti, rete vendita, clienti B2B o automazione di processi commerciali.</p>
        <a class="button button--page" href="/contattaci">Raccontaci il tuo processo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="faq-title">
    <div class="section-heading section-heading--center">
      <span class="section-kicker">FAQ</span>
      <h2 id="faq-title"><span class="gradient-text">Domande frequenti</span> prima di iniziare.</h2>
    </div>
    {{ faq(faqItems) }}
  </section>

  <section class="section section--compact container">
    {{ finalCta("Rendiamo più semplice un processo commerciale complesso.", "Partiamo da catalogo, utenti e passaggi reali per capire quale soluzione ha senso costruire.") }}
  </section>
</main>
{% endblock %}
