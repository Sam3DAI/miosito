{% block content %}
<main id="main-content">
  <section class="page-hero">
    <div class="page-hero__layout container">
      <div class="page-hero__copy">
        <span class="eyebrow">SolveX AI3D · Configuratori, CPQ e portali B2B</span>
        <h1>Configuratori e software commerciali su misura.</h1>
        <p class="hero-lead">Trasformiamo prodotti, listini e regole di vendita in strumenti web che aiutano aziende e reti commerciali a configurare, preventivare e vendere con meno errori.</p>
        <div class="cta-group">
          <a class="button" href="/contattaci">Parliamo del tuo progetto <span aria-hidden="true">↗</span></a>
          <a class="button button--secondary" href="#soluzioni">Esplora le soluzioni <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Progetti B2B costruiti intorno al processo reale.</p>
      </div>

      <figure class="software-visual" aria-label="Esempio illustrativo di un'interfaccia per configurare un prodotto e preparare un preventivo">
        <div class="software-visual__window">
          <div class="software-visual__toolbar">
            <div class="software-visual__dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <span class="software-visual__title">Configurazione prodotto</span>
            <span class="status-chip">Regole verificate</span>
          </div>
          <div class="software-visual__body">
            <div class="configuration-stage">
              <span class="configuration-stage__label">Prodotto · Vista illustrativa</span>
              <div class="product-object" aria-hidden="true"></div>
            </div>
            <div class="option-panel">
              <h2>Opzioni</h2>
              <div class="option-group">
                <span>Modello</span>
                <div class="option-choice is-selected"><span class="swatch"></span> Modulare</div>
                <div class="option-choice"><span class="swatch"></span> Lineare</div>
              </div>
              <div class="option-group">
                <span>Finitura</span>
                <div class="option-choice is-selected"><span class="swatch"></span> Variante A</div>
              </div>
              <div class="quote-summary">
                <div><span>Compatibilità</span><strong>Conforme</strong></div>
                <div><span>Riepilogo</span><strong>Pronto</strong></div>
              </div>
            </div>
          </div>
        </div>
        <figcaption>Interfaccia illustrativa: non rappresenta dati o prodotti di un cliente.</figcaption>
      </figure>
    </div>
  </section>

  <div class="trust-strip" aria-label="Ambiti della soluzione">
    <span>Cataloghi complessi</span><span>Regole commerciali</span><span>Preventivi e documenti</span><span>Reti vendita B2B</span>
  </div>

  <section class="section container" aria-labelledby="complexity-title">
    <div class="section-heading">
      <span class="section-kicker">Il problema</span>
      <h2 id="complexity-title">Quando il prodotto è complesso, la vendita non deve esserlo.</h2>
      <p>Un’interfaccia ben progettata rende esplicite le scelte, applica le regole e accompagna ogni utente verso un risultato verificabile.</p>
    </div>
    {{ visualCardRail("home-problems", "Problemi commerciali frequenti", problemItems) }}
  </section>

  <section id="soluzioni" class="section section--tinted" aria-labelledby="solutions-title">
    <div class="container">
      <div class="section-heading">
        <span class="section-kicker">Soluzioni</span>
        <h2 id="solutions-title">Una soluzione per ogni processo di vendita.</h2>
        <p>La tecnologia cambia, ma il criterio resta lo stesso: rendere più chiaro il percorso tra catalogo, scelta e proposta commerciale.</p>
      </div>
      <div class="solution-grid">
        <a class="card card--link card--gradient" href="/configuratori-ecommerce"><span class="card__label">E-commerce</span><h3>Guidare la personalizzazione prima dell’acquisto.</h3><p>Varianti, compatibilità, prezzo e passaggio al carrello dentro un’esperienza coerente.</p><span class="card__arrow">Scopri i configuratori e-commerce →</span></a>
        <a class="card card--link" href="/software-cpq-portali-commerciali"><span class="card__label">B2B</span><h3>Governare regole, listini e preventivi.</h3><p>Strumenti per agenti, dealer e clienti con ruoli, revisioni e documenti.</p><span class="card__arrow">Scopri CPQ e portali →</span></a>
        <a class="card card--link" href="/planner-configuratori-arredamento"><span class="card__label">Arredamento</span><h3>Comporre spazi e prodotti modulari.</h3><p>Misure, finiture, vincoli e offerte per produttori, showroom e rivenditori.</p><span class="card__arrow">Scopri planner e configuratori →</span></a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="capabilities-title">
    <div class="section-heading">
      <span class="section-kicker">Capability</span>
      <h2 id="capabilities-title">Visualizzare quando serve. Automatizzare dove crea valore.</h2>
    </div>
    <div class="capability-strip">
      <a class="card card--link" href="/configuratori-3d-2d"><span class="card__label">2D / 3D</span><h3>Configuratori di prodotto interattivi.</h3><p>La componente visiva aiuta a comprendere varianti, materiali e risultato della configurazione.</p><span class="card__arrow">Esplora i configuratori 2D/3D →</span></a>
      <a class="card card--link card--gradient" href="/automazioni-ai-business"><span class="card__label">AI integrata</span><h3>Automazioni dentro il processo commerciale.</h3><p>L’AI supporta documenti, richieste e workflow definiti, mantenendo controllo e supervisione.</p><span class="card__arrow">Esplora le automazioni AI →</span></a>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-heading section-heading--center">
        <span class="section-kicker">Flusso connesso</span>
        <h2 id="flow-title">Dal catalogo al preventivo, in un unico flusso.</h2>
        <p>Ogni modulo risponde a un passaggio concreto e può essere dimensionato sulle priorità del progetto.</p>
      </div>
      <div class="flow-panel" aria-label="Fasi e funzioni del flusso commerciale">
        <div class="flow-step"><span>01</span><strong>Configurazione</strong></div>
        <div class="flow-step"><span>02</span><strong>Regole</strong></div>
        <div class="flow-step"><span>03</span><strong>Prezzi e listini</strong></div>
        <div class="flow-step"><span>04</span><strong>Utenti e ruoli</strong></div>
        <div class="flow-step"><span>05</span><strong>PDF e documenti</strong></div>
        <div class="flow-step"><span>06</span><strong>Salvataggi</strong></div>
        <div class="flow-step"><span>07</span><strong>Revisioni</strong></div>
        <div class="flow-step"><span>08</span><strong>Integrazioni</strong></div>
      </div>
    </div>
  </section>

  <section id="progetti" class="section container" aria-labelledby="projects-title">
    <div class="section-heading">
      <span class="section-kicker">Esperienza applicata</span>
      <h2 id="projects-title">Tipologie di progetto già realizzate.</h2>
      <p>Esempi anonimi descritti per funzione, senza esporre nomi, dati o risultati dei clienti.</p>
    </div>
    <div class="proof-grid">
      <article class="card proof-card"><span class="card__label">Visuale</span><h3>Configurazione 3D di prodotto.</h3><p>Un’esperienza web per selezionare varianti e leggere visivamente la configurazione.</p></article>
      <article class="card proof-card"><span class="card__label">Commerciale</span><h3>Portale preventivi B2B.</h3><p>Un flusso riservato per organizzare configurazioni, dati commerciali e documenti.</p></article>
      <article class="card proof-card"><span class="card__label">Tecnico</span><h3>Configuratore tecnico con listini e PDF.</h3><p>Regole, opzioni e prezzi raccolti in un percorso guidato con generazione del preventivo.</p></article>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="method-title">
    <div class="container">
      <div class="section-heading">
        <span class="section-kicker">Metodo</span>
        <h2 id="method-title">Dal processo reale a uno strumento utilizzabile.</h2>
        <p>Decisioni visibili, verifiche progressive e una consegna costruita per chi dovrà usare la soluzione.</p>
      </div>
      {{ processSteps(methodSteps) }}
    </div>
  </section>

  <section class="section container" aria-labelledby="direct-title">
    <div class="split-panel">
      <div class="split-panel__lead">
        <span class="section-kicker">Collaborazione</span>
        <h2 id="direct-title">Un interlocutore diretto, competenze specialistiche quando servono.</h2>
        <p>SolveX mantiene un referente chiaro e la responsabilità diretta delle decisioni dall’analisi al rilascio.</p>
      </div>
      <div class="split-panel__body">
        <ul class="check-list">
          <li>Responsabilità chiara e confronto senza passaggi inutili.</li>
          <li>Specialisti coinvolti solo quando il perimetro lo richiede.</li>
          <li>Priorità, vincoli e verifiche condivisi durante il progetto.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="custom-process-title">
    <div class="container split-panel">
      <div class="split-panel__lead">
        <span class="section-kicker">Processi adiacenti</span>
        <h2 id="custom-process-title">Hai un processo fuori standard?</h2>
      </div>
      <div class="split-panel__body">
        <p>SolveX realizza anche portali e software web su misura quando il progetto riguarda cataloghi, preventivi, documenti, rete vendita, clienti B2B o automazione di processi commerciali.</p>
        <a class="button" href="/contattaci">Raccontaci il tuo processo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="faq-title">
    <div class="section-heading section-heading--center">
      <span class="section-kicker">FAQ</span>
      <h2 id="faq-title">Domande frequenti prima di iniziare.</h2>
    </div>
    {{ faq(faqItems) }}
  </section>

  <section class="section section--compact container">
    {{ finalCta("Rendiamo più semplice un processo commerciale complesso.", "Partiamo da catalogo, utenti e passaggi reali per capire quale soluzione ha senso costruire.") }}
  </section>
</main>
{% endblock %}
