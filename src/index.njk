{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import processSteps, faq, visualCardRail, finalCta %}

{% set methodSteps = [
  { title: "Analisi", text: "Obiettivi, utenti, dati e vincoli reali." },
  { title: "Prototipo", text: "Flussi e interfaccia verificati prima dello sviluppo." },
  { title: "Sviluppo", text: "Funzioni costruite sul perimetro concordato." },
  { title: "Test", text: "Regole, dispositivi e casi critici controllati." },
  { title: "Integrazione", text: "Collegamenti valutati sui sistemi disponibili." },
  { title: "Rilascio", text: "Messa online, passaggio operativo e supporto." }
] %}

{% set faqItems = [
  { question: "Quanto costa un configuratore su misura?", answer: "Dipende dalla profondità del catalogo, dalle regole, dalle integrazioni, dai ruoli utente e dall'eventuale componente 2D o 3D. Il preventivo nasce dopo una prima analisi del processo e del perimetro utile." },
  { question: "Si integra nel sito o e-commerce esistente?", answer: "Può integrarsi, ma la fattibilità va verificata sulle interfacce realmente disponibili: catalogo, API, checkout, autenticazione e tecnologia del sito esistente." },
  { question: "È meglio un configuratore 2D o 3D?", answer: "La scelta dipende da ciò che l'utente deve capire. Il 2D è spesso efficace per opzioni e composizioni; il 3D aggiunge valore quando forma, materiali o percezione spaziale influenzano la decisione." },
  { question: "Può gestire prezzi, regole e preventivi?", answer: "Sì, quando listini, vincoli e logiche commerciali sono definibili. La soluzione può guidare le combinazioni e preparare un riepilogo o un documento da sottoporre al flusso previsto." },
  { question: "È adatto anche alle PMI?", answer: "Sì, se risolve un processo concreto e il perimetro è proporzionato. Si parte dalle funzioni che riducono passaggi manuali e incertezza, senza costruire complessità non necessaria." }
] %}

{% set problemItems = [
  { index: "01", label: "Catalogo", title: "Molte varianti", text: "Opzioni, materiali e combinazioni rendono difficile orientarsi nel catalogo." },
  { index: "02", label: "Preventivi", title: "Preventivi manuali", text: "Passaggi ripetitivi aumentano tempi, duplicazioni e possibilità di errore." },
  { index: "03", label: "Vincoli", title: "Regole e incompatibilità", text: "Vincoli tecnici e commerciali richiedono un percorso guidato e coerente." },
  { index: "04", label: "Rete vendita", title: "Reti disallineate", text: "Cataloghi e procedure diverse possono produrre offerte non uniformi." }
] %}

