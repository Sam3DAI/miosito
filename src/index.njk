{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import processSteps, faq, visualCardRail, finalCta, functionIcon %}

{% set methodSteps = [
  { title: "Analisi", text: "Obiettivi, utenti, dati e vincoli reali." },
  { title: "Prototipo", text: "Flussi e interfaccia verificati prima dello sviluppo." },
  { title: "Sviluppo", text: "Funzioni costruite sul perimetro concordato." },
  { title: "Test", text: "Regole, dispositivi e casi critici controllati." },
  { title: "Integrazione", text: "Collegamenti valutati sui sistemi disponibili." },
  { title: "Rilascio", text: "Messa online, passaggio operativo e supporto." }
] %}

{% set faqItems = [
  { highlight: "Quanto costa", question: "Quanto costa un configuratore su misura?", answer: "Dipende dalla profondità del catalogo, dalle regole, dalle integrazioni, dai ruoli utente e dall'eventuale componente 2D o 3D. Il preventivo nasce dopo una prima analisi del processo e del perimetro utile." },
  { highlight: "Si integra", question: "Si integra nel sito o e-commerce esistente?", answer: "Può integrarsi, ma la fattibilità va verificata sulle interfacce realmente disponibili: catalogo, API, checkout, autenticazione e tecnologia del sito esistente." },
  { highlight: "2D o 3D", question: "È meglio un configuratore 2D o 3D?", answer: "La scelta dipende da ciò che l'utente deve capire. Il 2D è spesso efficace per opzioni e composizioni; il 3D aggiunge valore quando forma, materiali o percezione spaziale influenzano la decisione." },
  { highlight: "regole e preventivi", question: "Può gestire prezzi, regole e preventivi?", answer: "Sì, quando listini, vincoli e logiche commerciali sono definibili. La soluzione può guidare le combinazioni e preparare un riepilogo o un documento da sottoporre al flusso previsto." },
  { question: "È adatto anche alle PMI?", answer: "Sì, se risolve un processo concreto e il perimetro è proporzionato. Si parte dalle funzioni che riducono passaggi manuali e incertezza, senza costruire complessità non necessaria." }
] %}

{% set problemItems = [
  { label: "Catalogo", title: "Molte varianti", text: "Opzioni, materiali e combinazioni rendono difficile orientarsi nel catalogo.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/Configuratore_e-commerce_x0cfvo.jpg", alt: "Illustrazione SolveX di configurazione prodotto con varianti e materiali" },
  { label: "Preventivi", title: "Preventivi manuali", text: "Passaggi ripetitivi aumentano tempi, duplicazioni e possibilità di errore.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/CPQ_lv1miq.jpg", alt: "Interfaccia CPQ con configurazione e riepilogo commerciale" },
  { label: "Vincoli", title: "Regole e incompatibilità", text: "Vincoli tecnici e commerciali richiedono un percorso guidato e coerente.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911837/macchinari_e_attrezzature_ujxyrm.jpg", alt: "Configuratore per macchinari e attrezzature con opzioni tecniche" },
  { label: "Rete vendita", title: "Reti disallineate", text: "Cataloghi e procedure diverse possono produrre offerte non uniformi.", image: "https://res.cloudinary.com/dqhbriryo/image/upload/f_auto,q_auto,w_900,h_1150,c_fill,g_auto/v1777911838/Portale_commerciali_gu6ta3.jpg", alt: "Portale commerciale riservato con attività e configurazioni" }
] %}

