{% extends "layouts/base.njk" %}
{% from "partials/marketing-components.njk" import processSteps, finalCta %}

{% set methodSteps = [
  { title: "Analisi", text: "Processo, obiettivi, utenti e vincoli." },
  { title: "Prototipo", text: "Flussi verificabili prima del codice." },
  { title: "Sviluppo", text: "Funzioni sul perimetro condiviso." },
  { title: "Test", text: "Casi reali e condizioni critiche." },
  { title: "Integrazione", text: "Connessioni valutate sui sistemi." },
  { title: "Rilascio", text: "Consegna, passaggio e continuità." }
] %}

