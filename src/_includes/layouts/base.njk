<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "partials/seo-head.njk" %}
  {% block jsonLd %}{% endblock %}
  {% include "partials/measurement-bootstrap.njk" %}
  {% block headExtras %}{% endblock %}
</head>
<body data-page="{{ pageKey }}">
  <a href="#{{ mainId }}" class="skip-link">Salta al contenuto principale</a>

  {% include "partials/site-header.njk" %}

  {% if breadcrumbLabel %}
  <nav class="breadcrumb container" aria-label="Percorso">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-current="page">{{ breadcrumbLabel }}</li>
    </ol>
  </nav>
  {% endif %}

  {% block content %}{% endblock %}

  {% include "partials/site-footer.njk" %}

  {% include "partials/cookie-loader.njk" %}
</body>
</html>
