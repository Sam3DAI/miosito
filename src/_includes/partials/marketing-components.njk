{% macro processSteps(items) %}
<ol class="process-list">
  {% for item in items %}
  <li>
    <strong>{{ item.title }}</strong>
    <span>{{ item.text }}</span>
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{% macro faq(items) %}
<div class="faq-grid">
  {% for item in items %}
  <details class="faq-item">
    <summary>{{ item.question }}</summary>
    <div class="faq-item__answer"><p>{{ item.answer }}</p></div>
  </details>
  {% endfor %}
</div>
{% endmacro %}

{% macro functionIcon(name) %}
<svg class="function-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {% if name == "configuration" %}<path d="M12 3 4.5 7v10L12 21l7.5-4V7L12 3Zm-7.5 4L12 11l7.5-4M12 11v10"/>
  {% elif name == "rules" %}<circle cx="6" cy="6" r="2"/><circle cx="18" cy="7" r="2"/><circle cx="8" cy="18" r="2"/><path d="M7.8 6.3 16 6.8M6.5 8l1.1 8M9.8 17.2l5.9-2.8 3.1 3.1"/>
  {% elif name == "pricing" %}<path d="M4 5h9l7 7-8 8-8-8V5Z"/><circle cx="8" cy="9" r="1"/><path d="M13.5 10.5h3M12 13h3"/>
  {% elif name == "users" %}<circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2.2"/><path d="M3.5 20c.3-4 2.1-6 5.5-6s5.2 2 5.5 6M14 15c3.7-.4 5.8 1.3 6.3 5"/>
  {% elif name == "documents" %}<path d="M6 3h8l4 4v14H6V3Z"/><path d="M14 3v5h4M9 12h6M9 16h6"/>
  {% elif name == "saves" %}<path d="M4 7h16v13H4V7Z"/><path d="M7 3h10l2 4H5l2-4ZM9 11h6"/>
  {% elif name == "revisions" %}<path d="M5 8a8 8 0 1 1-1 8"/><path d="M5 3v5H0M12 7v5l3 2"/>
  {% elif name == "integrations" %}<path d="m9 15 6-6M7 17l-1 1a3.5 3.5 0 0 1-5-5l4-4a3.5 3.5 0 0 1 5 0M17 7l1-1a3.5 3.5 0 1 1 5 5l-4 4a3.5 3.5 0 0 1-5 0"/>{% endif %}
</svg>
{% endmacro %}

{% macro visualCardRail(id, label, items, variant="editorial") %}
<div class="visual-card-rail visual-card-rail--{{ variant }}" data-visual-card-rail role="region" aria-label="{{ label }}">
  <div class="visual-card-rail__controls" data-rail-controls hidden>
    <button type="button" data-rail-previous aria-controls="{{ id }}" aria-label="Mostra le card precedenti">
      <span aria-hidden="true">←</span>
    </button>
    <button type="button" data-rail-next aria-controls="{{ id }}" aria-label="Mostra le card successive">
      <span aria-hidden="true">→</span>
    </button>
  </div>
  <ol class="visual-card-rail__track" id="{{ id }}" data-rail-track tabindex="0">
    {% for item in items %}
    <li class="visual-card{% if item.image %} visual-card--image{% else %} visual-card--text{% endif %}" data-rail-card>
      {% if item.href %}<a class="visual-card__inner" href="{{ item.href }}">{% else %}<article class="visual-card__inner">{% endif %}
        {% if item.image %}
        <img class="visual-card__image" src="{{ item.image }}" srcset="{{ item.image | replace('w_900,h_1150', 'w_540,h_690') | replace(',', '%2C') }} 540w, {{ item.image | replace(',', '%2C') }} 900w, {{ item.image | replace('w_900,h_1150', 'w_1200,h_1533') | replace(',', '%2C') }} 1200w" sizes="(max-width: 720px) 82vw, 390px" alt="{{ item.alt or '' }}" width="900" height="1150" loading="lazy" decoding="async">
        {% endif %}
        <div class="visual-card__copy">
          {% if item.label %}<span class="visual-card__label">{{ item.label }}</span>{% endif %}
          <h3>{{ item.title }}</h3>
          <p>{{ item.text }}</p>
        </div>
      {% if item.href %}</a>{% else %}</article>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <div class="visual-card-rail__indicators" data-rail-indicators aria-hidden="true">
    {% for item in items %}<span{% if loop.first %} class="is-active"{% endif %}></span>{% endfor %}
  </div>
  <p class="visually-hidden" data-rail-status aria-live="polite">Card 1 di {{ items | length }}</p>
</div>
{% endmacro %}

{% macro finalCta(title, text, label="Parliamo del tuo progetto") %}
<div class="final-cta">
  <span class="section-kicker">Primo confronto</span>
  <h2>{{ title }}</h2>
  <p>{{ text }}</p>
  <a class="button" href="/contattaci">{{ label }} <span aria-hidden="true">↗</span></a>
</div>
{% endmacro %}
