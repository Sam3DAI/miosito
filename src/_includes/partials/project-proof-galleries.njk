{% set imageRoot = "/assets/images/projects-44r2/" %}
<div class="visual-card-rail visual-card-rail--landscape project-proof-rail" data-visual-card-rail role="region" aria-label="Progetti realizzati">
  <div class="visual-card-rail__controls" data-rail-controls hidden>
    <button type="button" data-rail-previous aria-controls="home-projects" aria-label="Mostra le card precedenti"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m14.5 5-7 7 7 7"/></svg></button>
    <button type="button" data-rail-next aria-controls="home-projects" aria-label="Mostra le card successive"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9.5 5 7 7-7 7"/></svg></button>
  </div>
  <ol class="visual-card-rail__track" id="home-projects" data-rail-track tabindex="0">
    {% for project in projectProofs %}
    {% set cover = project.views[0] %}
    <li class="visual-card visual-card--image" data-rail-card>
      <a class="visual-card__inner" href="#progetto-{{ project.id }}" data-project-trigger="{{ project.id }}" aria-label="Esplora il progetto {{ project.name }}">
        <div class="visual-card__copy"><h3>{{ project.name }}</h3><p>{{ project.description }}</p><span class="project-proof-cta">Esplora il progetto <span aria-hidden="true">↗</span></span></div>
        <div class="project-media"><img src="{{ imageRoot }}{{ cover.file }}-800.webp" srcset="{{ imageRoot }}{{ cover.file }}-480.webp 480w, {{ imageRoot }}{{ cover.file }}-800.webp 800w" sizes="(max-width: 720px) calc(100vw - 3rem), 560px" width="{{ cover.width }}" height="{{ cover.height }}" alt="{{ cover.alt }}" loading="lazy" decoding="async"></div>
      </a>
    </li>
    {% endfor %}
  </ol>
  <div class="visual-card-rail__indicators" data-rail-indicators aria-hidden="true">{% for project in projectProofs %}<span{% if loop.first %} class="is-active"{% endif %}></span>{% endfor %}</div>
  <p class="visually-hidden" data-rail-status aria-live="polite">Card 1 di {{ projectProofs | length }}</p>
</div>
{% for project in projectProofs %}
<section id="progetto-{{ project.id }}" class="project-proof-fallback container" data-project-fallback="{{ project.id }}" aria-labelledby="fallback-title-{{ project.id }}">
  <h3 id="fallback-title-{{ project.id }}">{{ project.title }}</h3>
  <p>{{ project.description }}</p>
  <p>Interfaccia del progetto con dati dimostrativi.</p>
  <ol>{% for view in project.views %}<li><a href="{{ imageRoot }}{{ view.file }}-1280.webp">{{ view.caption }}</a></li>{% endfor %}</ol>
  <a href="/contattaci#contatti">Richiedi una soluzione simile</a>
</section>
<dialog class="proof-gallery" data-project-dialog="{{ project.id }}" aria-labelledby="gallery-title-{{ project.id }}" aria-describedby="gallery-description-{{ project.id }}">
  <header class="proof-gallery__header"><h3 id="gallery-title-{{ project.id }}">{{ project.title }}</h3><button type="button" class="proof-gallery__close" data-gallery-close aria-label="Chiudi la galleria {{ project.name }}" autofocus><span aria-hidden="true">×</span></button></header>
  <div class="proof-gallery__body">
    <p id="gallery-description-{{ project.id }}">{{ project.description }}</p>
    <p class="proof-gallery__note">Interfaccia del progetto con dati dimostrativi.</p>
    {% for view in project.views %}
    <figure data-gallery-view{% if not loop.first %} hidden{% endif %}>
      <img data-gallery-src="{{ imageRoot }}{{ view.file }}-1280.webp" data-gallery-srcset="{{ imageRoot }}{{ view.file }}-480.webp 480w, {{ imageRoot }}{{ view.file }}-800.webp 800w, {{ imageRoot }}{{ view.file }}-1280.webp 1280w" sizes="(max-width: 720px) calc(100vw - 3rem), (max-width: 1120px) calc(100vw - 5rem), 1040px" width="{{ view.width }}" height="{{ view.height }}" alt="{{ view.alt }}" decoding="async">
      <figcaption>{{ view.caption }}</figcaption>
    </figure>
    {% endfor %}
    <nav class="proof-gallery__navigation" aria-label="Immagini del progetto {{ project.name }}">
      <button type="button" data-gallery-previous aria-label="Immagine precedente"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m14.5 5-7 7 7 7"/></svg></button>
      <span data-gallery-status role="status" aria-live="polite">Immagine 1 di {{ project.views | length }}</span>
      <button type="button" data-gallery-next aria-label="Immagine successiva"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9.5 5 7 7-7 7"/></svg></button>
    </nav>
    <a class="button button--page" href="/contattaci#contatti">Richiedi una soluzione simile <span aria-hidden="true">↗</span></a>
  </div>
</dialog>
{% endfor %}
