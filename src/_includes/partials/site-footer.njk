{% from "partials/social-icon.njk" import socialIcon %}
  <footer class="site-footer">
    <div class="site-footer__inner container">
      <div class="site-footer__brand">
        <a href="/" class="brand brand--footer" aria-label="SolveX AI3D, homepage">
          <img src="{{ site.logoPath }}" alt="" class="brand__mark" width="32" height="32" loading="lazy" decoding="async">
          <span class="brand__name">{{ site.name }}</span>
        </a>
        <p>Configuratori e software commerciali su misura per processi B2B complessi.</p>
      </div>

      <div class="site-footer__column">
        <h2>Soluzioni</h2>
        <ul>
          {% for item in navigation.solutions %}<li><a href="{{ item.href }}"{% if pageKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>{% endfor %}
        </ul>
      </div>

      <div class="site-footer__column">
        <h2>Esplora</h2>
        <ul>
          <li><a href="/#progetti">Progetti</a></li>
          <li><a href="/chi-siamo#metodo">Metodo</a></li>
          <li><a href="/chi-siamo"{% if pageKey == "about" %} aria-current="page"{% endif %}>Chi siamo</a></li>
          <li><a href="/contattaci">Contatti</a></li>
          <li><a href="/privacy-policy"{% if pageKey == "privacy" %} aria-current="page"{% endif %}>Privacy</a></li>
          <li><a href="/termini-condizioni"{% if pageKey == "terms" %} aria-current="page"{% endif %}>Termini</a></li>
        </ul>
      </div>

      <div class="site-footer__column site-footer__public-data">
        <h2>Dati pubblici SolveX</h2>
        <address>
          <span>P. IVA {{ site.vatNumber }}</span>
          <span>{{ site.addressLine1 }}</span>
          <span>{{ site.addressLine2 }}</span>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          <a href="tel:+393474380837">{{ site.phone }}</a>
        </address>
        <div class="site-footer__social" aria-label="Profili social SolveX AI3D">
          {% for item in navigation.social %}<a href="{{ item.href }}" rel="noopener" aria-label="SolveX AI3D su {{ item.label }}">{{ socialIcon(item.label) }}<span class="visually-hidden">{{ item.label }}</span></a>{% endfor %}
        </div>
      </div>
    </div>
    <div class="site-footer__bottom container">
      <p>© {{ site.copyrightYear }} SolveX AI3D. Tutti i diritti riservati.</p>
      <a href="/contattaci">Parliamo del tuo progetto <span aria-hidden="true">↗</span></a>
    </div>
  </footer>
