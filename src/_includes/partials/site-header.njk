  <header class="site-header" data-site-header>
    <div class="site-header__inner container">
      <a href="/" class="brand" aria-label="SolveX AI3D, homepage"{% if pageKey == "home" %} aria-current="page"{% endif %}>
        <img src="{{ site.logoPath }}" alt="" class="brand__mark" width="32" height="32" decoding="async">
        <span class="brand__name">SolveX <strong>AI3D</strong></span>
      </a>

      <nav class="desktop-navigation" aria-label="Navigazione principale">
        <details class="solutions-menu">
          <summary>Soluzioni <svg aria-hidden="true" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4"/></svg></summary>
          <div class="solutions-menu__panel">
            <p class="solutions-menu__label">Soluzioni commerciali su misura</p>
            <ul>
              {% for item in navigation.solutions %}
              <li>
                <a href="{{ item.href }}"{% if pageKey == item.key %} aria-current="page"{% endif %}>
                  <span>{{ item.label }}</span>
                  <small>{{ item.description }}</small>
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </details>
        {% for item in navigation.primary %}
        <a href="{{ item.href }}"{% if pageKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>

      <div class="site-header__actions">
        <button class="theme-toggle" type="button" aria-label="Attiva il tema scuro" aria-pressed="false" data-theme-toggle>
          <svg class="theme-icon theme-icon--sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-icon theme-icon--moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"/></svg>
        </button>
        <a class="button button--compact header-cta" href="{{ navigation.cta.href }}">{{ navigation.cta.label }}</a>
        <details class="mobile-navigation" data-mobile-menu>
          <summary aria-label="Apri menu principale">
            <span class="mobile-navigation__label">Menu</span>
            <span class="hamburger-bars" aria-hidden="true"><span></span><span></span></span>
          </summary>
          <nav class="mobile-navigation__panel" aria-label="Navigazione mobile">
            <p class="mobile-navigation__eyebrow">Soluzioni</p>
            {% for item in navigation.solutions %}
            <a href="{{ item.href }}"{% if pageKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
            <div class="mobile-navigation__divider"></div>
            {% for item in navigation.primary %}
            <a href="{{ item.href }}"{% if pageKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
            <a class="button" href="{{ navigation.cta.href }}">{{ navigation.cta.label }}</a>
          </nav>
        </details>
      </div>
    </div>
  </header>
