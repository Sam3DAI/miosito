{% from "partials/social-icon.njk" import socialIcon %}
  <header class="site-header" data-site-header>
    <div class="site-header__inner container">
      <a href="/" class="brand" aria-label="SolveX AI3D, homepage"{% if pageKey == "home" %} aria-current="page"{% endif %}>
        <img src="{{ site.logoPath }}" alt="" class="brand__mark" width="32" height="32" decoding="async">
        <span class="brand__name">{{ site.name }}</span>
      </a>

      <div class="site-header__actions">
        <button class="theme-toggle" type="button" aria-label="Attiva il tema scuro" aria-pressed="false" data-theme-toggle>
          <svg class="theme-icon theme-icon--sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-icon theme-icon--moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"/></svg>
        </button>
        <a class="button button--compact button--menu button--project header-cta" href="{{ navigation.cta.href }}">{{ navigation.cta.label }}</a>

        <details class="site-navigation" data-site-menu>
          <summary class="site-navigation__trigger" aria-label="Apri il menu principale" aria-controls="site-menu-overlay">
            <span class="hamburger-bars" aria-hidden="true"><span></span><span></span></span>
          </summary>

          <div class="site-navigation__overlay" id="site-menu-overlay">
            <div class="site-navigation__layout container">
              <nav class="site-navigation__solutions" aria-label="Soluzioni">
                <p class="site-navigation__eyebrow">Soluzioni</p>
                <ol>
                  {% for item in navigation.solutions %}
                  <li>
                    <a href="{{ item.href }}"{% if pageKey == item.key %} aria-current="page"{% endif %}>
                      <span class="site-navigation__link-copy">
                        <strong>{{ item.label }}</strong>
                        <small>{{ item.description }}</small>
                      </span>
                    </a>
                  </li>
                  {% endfor %}
                </ol>
              </nav>

              <div class="site-navigation__secondary">
                <nav aria-label="Pagine principali">
                  <p class="site-navigation__eyebrow">Esplora</p>
                  <ul class="site-navigation__secondary-links">
                    {% for item in navigation.primary %}
                    <li><a href="{{ item.href }}"{% if pageKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
                    {% endfor %}
                  </ul>
                </nav>

                <a class="button button--menu button--project site-navigation__cta" href="{{ navigation.cta.href }}">{{ navigation.cta.label }} <span aria-hidden="true">↗</span></a>

                <div class="site-navigation__contact">
                  <p class="site-navigation__eyebrow">SolveX AI3D</p>
                  <address>
                    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
                    <a href="tel:+393474380837">{{ site.phone }}</a>
                    <span>{{ site.addressLine1 }} · {{ site.addressLine2 }}</span>
                  </address>
                  <div class="site-navigation__social" aria-label="Profili social SolveX AI3D">
                    {% for item in navigation.social %}<a href="{{ item.href }}" rel="noopener" aria-label="SolveX AI3D su {{ item.label }}">{{ socialIcon(item.label, "menu") }}<span class="visually-hidden">{{ item.label }}</span></a>{% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </details>
      </div>
    </div>
  </header>
